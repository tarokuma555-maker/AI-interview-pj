# 開発環境では .env.local にコピーして値を入れる。本番は Vercel の環境変数に設定する。

# 招待のコード。求職者には https://<ドメイン>/join#<コード> を招待リンクとして送る。
# 検証ツール(/poc)では画面で入力する。未設定だと API は使えない
POC_ACCESS_CODE=

# Claude API キー(サーバーのみで使う)
ANTHROPIC_API_KEY=
# ワークスペースに属していないAPIキーを使う場合だけ、使うワークスペースのID(wrkspc_...)を入れる
ANTHROPIC_WORKSPACE_ID=

# mock にすると Claude API を呼ばずに固定の文面で動く(APIキーなしで画面を確認するとき)
AI_PROVIDER=

# 面接官・質問計画のモデル(省略時は設計書 4.1 の既定値)
# AI_MODEL_INTERVIEWER_SONNET=claude-sonnet-5-5
# AI_MODEL_INTERVIEWER_OPUS=claude-opus-5-5
# AI_MODEL_PLAN=claude-opus-5-5
# AI_MODEL_FEEDBACK=claude-opus-5-5

# Google Cloud の API キー。音声合成(Text-to-Speech)と音声認識(Speech-to-Text)に使う。
# Google Cloud で両方の API を有効にし、キーの制限(API の制限)でこの2つだけを許可する
GOOGLE_TTS_API_KEY=
# 音声認識だけ別のキーを使う場合(未設定なら GOOGLE_TTS_API_KEY を使う)
GOOGLE_STT_API_KEY=

# Azure AI Speech(音声認識・音声合成)。未設定ならブラウザ標準の音声認識・読み上げで試せる
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# 製品版の面接官の声(Google Cloud の声の名前)。未設定なら男性の Chirp 3 HD の声のうち一覧の先頭を使う
INTERVIEWER_VOICE_ID=

# Supabase(エージェントのログインとデータの保存。設計 docs/superpowers/specs/2026-10-27-agent-invite-design.md)。
# 両方を設定すると Supabase を使う。未設定なら、サーバーのメモリに置く開発用の方式で動く(確認コードを画面に出す)。
# 本番(Vercel の Production)では必ず設定する(未設定だとエージェントの画面は動かない)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
