# 開発環境では .env.local にコピーして値を入れる。本番は Vercel の環境変数に設定する。

# 試作版(/poc)のアクセスコード。未設定だと試作版の API は使えない
POC_ACCESS_CODE=

# Claude API キー(サーバーのみで使う)
ANTHROPIC_API_KEY=

# mock にすると Claude API を呼ばずに固定の文面で動く(APIキーなしで画面を確認するとき)
AI_PROVIDER=

# 面接官・質問計画のモデル(省略時は設計書 4.1 の既定値)
# AI_MODEL_INTERVIEWER_SONNET=claude-sonnet-5-5
# AI_MODEL_INTERVIEWER_OPUS=claude-opus-5-5
# AI_MODEL_PLAN=claude-opus-5-5

# Azure AI Speech(音声認識・音声合成)。未設定ならブラウザ標準の音声認識・読み上げで試せる
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
